# Coordinador y nodos del clúster de entrenamiento distribuido.
FROM golang:1.27-alpine AS compilacion
WORKDIR /src
COPY go/go.mod ./go/
COPY go/ ./go/
WORKDIR /src/go
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /salida/coordinador ./coordinador && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /salida/nodo ./nodo

FROM alpine:3.20
WORKDIR /app
COPY --from=compilacion /salida/coordinador /app/coordinador
COPY --from=compilacion /salida/nodo /app/nodo
EXPOSE 9000
